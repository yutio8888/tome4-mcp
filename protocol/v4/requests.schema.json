{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome://protocol/v4/requests.schema.json",
  "title": "ToME MCP Bridge v4 TCP request envelope",
  "$comment": "Spec v1.0 section 2.1/8.1/11. Internal TCP protocol only; the external MCP protocol is negotiated by the SDK.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "op",
    "args"
  ],
  "properties": {
    "v": {
      "const": 4
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "x-max-utf8-bytes": 256
    },
    "op": {
      "type": "string",
      "enum": [
        "connect",
        "connect_observer",
        "observe",
        "inspect",
        "list_collection",
        "act",
        "respond",
        "status",
        "stop",
        "dismiss",
        "abandon",
        "level_map",
        "policy",
        "policy_log"
      ]
    },
    "args": {
      "type": "object"
    }
  },
  "$defs": {
    "ConnectArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ObserveArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "radius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "include_map": {
          "type": "boolean"
        },
        "events_after": {
          "$ref": "common.schema.json#/$defs/EventCursor"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "player",
              "map",
              "ground",
              "actors",
              "talents",
              "events",
              "dialogs",
              "scene",
              "effects",
              "sustains",
              "resources",
              "stats",
              "ground_effects"
            ]
          },
          "uniqueItems": true
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "full"
          ]
        }
      }
    },
    "InspectArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "kind",
        "id"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "talent",
            "actor",
            "character",
            "progression",
            "item",
            "compatibility"
          ]
        },
        "id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "target_id": {
          "$ref": "common.schema.json#/$defs/EntityId"
        },
        "x": {
          "$ref": "common.schema.json#/$defs/Coordinate"
        },
        "y": {
          "$ref": "common.schema.json#/$defs/Coordinate"
        },
        "computed": {
          "type": "boolean"
        }
      }
    },
    "ListArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "request"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "request": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "collection"
              ],
              "properties": {
                "type": {
                  "const": "first"
                },
                "collection": {
                  "type": "string",
                  "enum": [
                    "inventory",
                    "equipment",
                    "actors",
                    "talents",
                    "effects",
                    "ground_items",
                    "progression_categories",
                    "progression_talents",
                    "compatibility"
                  ]
                },
                "page_size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                "filter": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "cursor"
              ],
              "properties": {
                "type": {
                  "const": "next"
                },
                "cursor": {
                  "$ref": "common.schema.json#/$defs/Cursor"
                }
              }
            }
          ]
        }
      }
    },
    "ActArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "control_token",
        "command_id",
        "expected_revision",
        "action"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "control_token": {
          "$ref": "common.schema.json#/$defs/ControlToken"
        },
        "command_id": {
          "$ref": "common.schema.json#/$defs/CommandId"
        },
        "expected_revision": {
          "$ref": "common.schema.json#/$defs/Revision"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "include_map": {
          "type": "boolean"
        }
      }
    },
    "RespondArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "control_token",
        "command_id",
        "interaction_id",
        "response_id",
        "expected_revision",
        "answer"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "control_token": {
          "$ref": "common.schema.json#/$defs/ControlToken"
        },
        "command_id": {
          "$ref": "common.schema.json#/$defs/CommandId"
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1,
          "x-max-utf8-bytes": 256
        },
        "response_id": {
          "$ref": "common.schema.json#/$defs/ResponseId"
        },
        "expected_revision": {
          "$ref": "common.schema.json#/$defs/Revision"
        },
        "answer": {
          "$ref": "#/$defs/Answer"
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "include_map": {
          "type": "boolean"
        }
      }
    },
    "StatusArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "command_id"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "command_id": {
          "$ref": "common.schema.json#/$defs/CommandId"
        },
        "response_id": {
          "$ref": "common.schema.json#/$defs/ResponseId"
        },
        "include_map": {
          "type": "boolean"
        },
        "options_offset": {
          "type": "integer",
          "minimum": 0
        },
        "compact": {
          "type": "boolean"
        }
      }
    },
    "StopArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "control_token"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "control_token": {
          "$ref": "common.schema.json#/$defs/ControlToken"
        }
      }
    },
    "DismissArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "control_token",
        "answer"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "control_token": {
          "$ref": "common.schema.json#/$defs/ControlToken"
        },
        "interaction_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "answer": {
          "$ref": "#/$defs/Answer"
        },
        "include_map": {
          "type": "boolean"
        }
      }
    },
    "AbandonArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "control_token"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "control_token": {
          "$ref": "common.schema.json#/$defs/ControlToken"
        }
      }
    },
    "LevelMapArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "source": {
          "type": "string",
          "enum": [
            "native_map"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "rows",
            "region"
          ]
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        }
      }
    },
    "PolicyArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "policy_op"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "policy_op": {
          "type": "string",
          "enum": [
            "status",
            "validate",
            "dry_run",
            "set_draft",
            "approve",
            "activate",
            "deactivate",
            "start",
            "stop",
            "pause",
            "resume",
            "log",
            "replay",
            "presets",
            "preset",
            "export",
            "import",
            "import_assistant",
            "get",
            "clear"
          ]
        },
        "policy": {
          "type": "object"
        },
        "config": {
          "type": "object"
        },
        "expected_hash": {
          "type": "string",
          "minLength": 1,
          "x-max-utf8-bytes": 256
        },
        "reason": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "after_seq": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "document": {
          "type": "string"
        },
        "store": {
          "type": "boolean"
        }
      }
    },
    "PolicyLogArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "$ref": "common.schema.json#/$defs/SessionId"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "direction"
          ],
          "properties": {
            "type": {
              "const": "move"
            },
            "direction": {
              "$ref": "common.schema.json#/$defs/Direction"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "wait"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "auto_explore"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "change_level"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "rest"
            },
            "max_turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target_id"
          ],
          "properties": {
            "type": {
              "const": "attack"
            },
            "target_id": {
              "$ref": "common.schema.json#/$defs/EntityId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "talent_id"
          ],
          "properties": {
            "type": {
              "const": "use_talent"
            },
            "talent_id": {
              "$ref": "common.schema.json#/$defs/TalentId"
            },
            "target_id": {
              "$ref": "common.schema.json#/$defs/EntityId"
            },
            "x": {
              "$ref": "common.schema.json#/$defs/Coordinate"
            },
            "y": {
              "$ref": "common.schema.json#/$defs/Coordinate"
            }
          },
          "oneOf": [
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "target_id"
                    ]
                  },
                  {
                    "required": [
                      "x"
                    ]
                  },
                  {
                    "required": [
                      "y"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "target_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "x"
                    ]
                  },
                  {
                    "required": [
                      "y"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "x",
                "y"
              ],
              "not": {
                "required": [
                  "target_id"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "talent_id",
            "enabled"
          ],
          "properties": {
            "type": {
              "const": "set_sustain"
            },
            "talent_id": {
              "$ref": "common.schema.json#/$defs/TalentId"
            },
            "enabled": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "stat"
          ],
          "properties": {
            "type": {
              "const": "spend_stat"
            },
            "stat": {
              "type": "string",
              "enum": [
                "str",
                "dex",
                "mag",
                "wil",
                "cun",
                "con"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "talent_id"
          ],
          "properties": {
            "type": {
              "const": "learn_talent"
            },
            "talent_id": {
              "$ref": "common.schema.json#/$defs/TalentId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "talent_id"
          ],
          "properties": {
            "type": {
              "const": "unlearn_talent"
            },
            "talent_id": {
              "$ref": "common.schema.json#/$defs/TalentId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "category_id"
          ],
          "properties": {
            "type": {
              "const": "learn_category"
            },
            "category_id": {
              "$ref": "common.schema.json#/$defs/CategoryId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "item_id"
          ],
          "properties": {
            "type": {
              "const": "pickup"
            },
            "item_id": {
              "$ref": "common.schema.json#/$defs/EntityId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "item_id"
          ],
          "properties": {
            "type": {
              "const": "equip"
            },
            "item_id": {
              "$ref": "common.schema.json#/$defs/EntityId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "item_id"
          ],
          "properties": {
            "type": {
              "const": "unequip"
            },
            "item_id": {
              "$ref": "common.schema.json#/$defs/EntityId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "item_id"
          ],
          "properties": {
            "type": {
              "const": "use_item"
            },
            "item_id": {
              "$ref": "common.schema.json#/$defs/EntityId"
            }
          }
        }
      ]
    },
    "Answer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "target_id"
          ],
          "properties": {
            "type": {
              "const": "actor"
            },
            "target_id": {
              "$ref": "common.schema.json#/$defs/EntityId"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "x",
            "y"
          ],
          "properties": {
            "type": {
              "const": "position"
            },
            "x": {
              "$ref": "common.schema.json#/$defs/Coordinate"
            },
            "y": {
              "$ref": "common.schema.json#/$defs/Coordinate"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "direction"
          ],
          "properties": {
            "type": {
              "const": "direction"
            },
            "direction": {
              "$ref": "common.schema.json#/$defs/Direction"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "option_id"
          ],
          "properties": {
            "type": {
              "const": "option"
            },
            "option_id": {
              "$ref": "common.schema.json#/$defs/OptionId"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "cancel"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "op": {
          "const": "connect"
        },
        "args": {
          "$ref": "#/$defs/ConnectArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "connect_observer"
        },
        "args": {
          "$ref": "#/$defs/ConnectArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "observe"
        },
        "args": {
          "$ref": "#/$defs/ObserveArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "inspect"
        },
        "args": {
          "$ref": "#/$defs/InspectArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "list_collection"
        },
        "args": {
          "$ref": "#/$defs/ListArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "act"
        },
        "args": {
          "$ref": "#/$defs/ActArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "respond"
        },
        "args": {
          "$ref": "#/$defs/RespondArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "status"
        },
        "args": {
          "$ref": "#/$defs/StatusArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "stop"
        },
        "args": {
          "$ref": "#/$defs/StopArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "dismiss"
        },
        "args": {
          "$ref": "#/$defs/DismissArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "abandon"
        },
        "args": {
          "$ref": "#/$defs/AbandonArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "level_map"
        },
        "args": {
          "$ref": "#/$defs/LevelMapArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "policy"
        },
        "args": {
          "$ref": "#/$defs/PolicyArgs"
        }
      }
    },
    {
      "properties": {
        "op": {
          "const": "policy_log"
        },
        "args": {
          "$ref": "#/$defs/PolicyLogArgs"
        }
      }
    }
  ]
}
